# Software Defecta environment configuration
# Copy this file to ".env" and adjust as needed.

# ── AUTHENTICATION ──────────────────────────────────────
# Default PIN for seeded users (change after first login)
# Seeded users: damayanti (Apoteker), faizin (Manajer),
#   aisyiyah (Staf), a.nggun (Staf)
DEFAULT_USER_PIN=123456

# Optional: shared PIN fallback for legacy login (set to empty to disable)
# APP_PIN maps to APP_PASSWORD for backward compatibility
APP_PIN=

# ── DATABASE ────────────────────────────────────────────
# SQLite only (single file, no separate database server).
DB_DRIVER=sqlite

# Path of the SQLite file inside the container (volume: sqlite_data)
DB_SQLITE_PATH=/var/www/html/data/defecta.sqlite
