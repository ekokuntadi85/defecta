# Software Defecta environment configuration
# Copy this file to ".env" and adjust as needed.
#
# NOTE on naming: APP_PIN maps to APP_PASSWORD (app login PIN) and
# MARIADB_PW maps to MARIADB_PASSWORD (database password).
# docker-compose.yml translates these for you, so you only edit here.

# Application (PHP / app container)
DB_HOST=db
DB_PORT=3306
DB_NAME=defecta_apotik
DB_USER=defecta
DB_PASS=change_this_db
APP_PIN=change_this_pin

# Database (MariaDB / db container)
MARIADB_DATABASE=defecta_apotik
MARIADB_USER=defecta
MARIADB_PW=change_this_pw
