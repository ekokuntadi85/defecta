# Software Defecta environment configuration
# Copy this file to ".env" and adjust as needed.
#
# APP_PIN maps to APP_PASSWORD (app login PIN).

# Application (PHP / app container)
APP_PIN=change_this_pin

# Database: SQLite only (single file, no separate database server).
DB_DRIVER=sqlite
# Path of the SQLite file inside the container (volume: sqlite_data)
DB_SQLITE_PATH=/var/www/html/data/defecta.sqlite
